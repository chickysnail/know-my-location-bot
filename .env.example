# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
INGEST_TOKEN=your_shared_secret         # any random string; must match Tasker's X-Auth-Token
ACCESS_PASSWORD=your_access_password    # anyone who sends this to the bot gets access
ADMIN_USER_IDS=123456789                # comma-separated Telegram user IDs (get notified, can /block)

# Optional
ALLOWED_USER_IDS=                       # pre-approved user IDs that skip the password
DATABASE_PATH=./locations.db            # Railway Volume: /data/locations.db
RETENTION_DAYS=7                        # older points are deleted automatically
MAX_ACCURACY_M=500                      # points with worse GPS accuracy are discarded
HISTORY_HOURS=6                         # how far back /where looks
HISTORY_POINTS=10                       # max points shown per /where
HEARTBEAT_URL=                          # heartbeat monitor ping URL; empty disables it
HEARTBEAT_INTERVAL_SECONDS=60           # how often the bot pings the monitor
LOG_LEVEL=INFO
